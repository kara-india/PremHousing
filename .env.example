# Optional WhatsApp Business destination, international format, digits only.
# Example: 919876543210 (do not include + or spaces)
VITE_WHATSAPP_NUMBER=

# Vite exposes these values to the browser. Use only the Supabase publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Mapbox token if a map is added in a later phase.
# VITE_MAPBOX_TOKEN=
